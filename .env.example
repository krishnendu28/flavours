# Fast2SMS API key for OTP delivery (optional - falls back to console)
FAST2SMS_API_KEY=

# Comma-separated list of allowed CORS origins (for Vercel frontend URLs)
# Example: https://flavours-bob-user.vercel.app,https://flavours-bob-admin.vercel.app
CORS_ORIGINS=

# Server port (default: 3001)
PORT=3001
