# Prefix for all DynamoDB tables (default: flavours-bob)
TABLE_PREFIX=flavours-bob

# AWS region (default: ap-south-1)
AWS_REGION=ap-south-1

# Secret used to sign auth tokens. MUST be a long random string in production.
AUTH_SECRET=

# Optional: Expo push access token. Only needed if "Push Security" is enabled
# in your EAS project settings. Leave empty for the default (no auth) mode.
# EXPO_PUSH_ACCESS_TOKEN=

# Optional: point the SDK at a local DynamoDB (e.g. http://localhost:8000) for local dev
# DYNAMODB_ENDPOINT=http://localhost:8000
