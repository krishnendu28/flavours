# REST API base URL.
# Leave unset for local dev (Vite proxies /api to :3001 via serverless-offline).
# For production, set to the API Gateway ApiUrl:
#   https://<api-id>.execute-api.<region>.amazonaws.com/<stage>
VITE_API_URL=

# WebSocket URL for real-time updates.
# Local (serverless-offline): ws://localhost:3002
# Production: set to the stack WsUrl output (wss://...).
VITE_WS_URL=ws://localhost:3002
